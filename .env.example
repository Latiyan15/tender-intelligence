# Database (Auto-configured on Render via PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host/dbname

# Email Notification Configuration
ALERT_RECIPIENT_EMAIL=nikominfrasolutionsss@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nikominfrasolutionsss@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Nikom Tender Intelligence <nikominfrasolutionsss@gmail.com>

# Outbound Scraper Proxy (Bypasses Indian Gov WAF on Cloud Deployments)
# HTTP proxy in India (Google Cloud Mumbai)
PROXY_URL=http://34.100.244.79:80

# AWS Bedrock Foundation Model Configuration
# Region where your Bedrock endpoint was created (e.g. ap-southeast-2, ap-south-1, us-east-1)
AWS_REGION=ap-southeast-2

# Option A: Bedrock Long-Term API Key (if provided as bearer key)
BEDROCK_API_KEY=your_bedrock_api_key_here

# Option B: AWS IAM Credentials (Access Key ID & Secret Access Key)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Bedrock Model ID or Cross-Region Inference Profile ARN / ID
# Claude Sonnet 4.6 (AU Cross-Region profile or direct ID):
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-6-v1:0
# Or standard model ID:
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6-v1:0


